{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gak-dashboard",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://dash.anugerahkristus.org",
    "NEXT_PUBLIC_APP_URL": "https://dash.anugerahkristus.org"
  }
}
